{
  "name": "nuxt-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Nuxt 4 starter with a runtime SCSS token system, BEM conventions and guardrails for AI-assisted development.",
  "license": "MIT",
  "author": "Obaydur Rahman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opuu/nuxt-boilerplate.git"
  },
  "bugs": "https://github.com/opuu/nuxt-boilerplate/issues",
  "homepage": "https://github.com/opuu/nuxt-boilerplate#readme",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "biome check . && stylelint \"app/**/*.{scss,vue}\"",
    "lint:fix": "biome check --write . && stylelint \"app/**/*.{scss,vue}\" --fix",
    "format": "biome format --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@nuxt/test-utils": "^4.3.4",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.3",
    "postcss-html": "^2.0.0",
    "sass-embedded": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.2",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
